app "Counter"

window title="Counter" fill {
  col gap=16 pad=24 fill {
    label #count text="0" align="center" grow

    row gap=8 {
      button grow text="-" click {
        count.text = count.text - 1
      }
      button grow text="+" click {
        count.text = count.text + 1
      }
    }

    button text="Reset" click {
      count.text = "0"
    }
  }
}
